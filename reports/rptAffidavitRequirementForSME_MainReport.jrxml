	<pageHeader height="159" splitType="Stretch">
		<element kind="staticText" uuid="924bfd80-d3f6-4ce5-ad39-8509e047bb90" x="220" y="0" width="100" height="30" fontSize="12.0" bold="true" underline="true" hTextAlign="Center" vTextAlign="Middle">
			<text><![CDATA[Affidavit]]></text>
		</element>
		<element kind="textField" uuid="c03b0abb-6cfc-4690-8e7a-0cdec23a7532" positionType="Float" x="1" y="53" width="555" height="30" fontSize="11.0" textAdjust="StretchHeight" hTextAlign="Justified">
			<expression><![CDATA["I, " + $F{Owners} +", "+ $F{OwnerType} + "of " +  $F{BusinessName} +  $F{OwnerInfo} + ", "+ "do hereby solemnly affirm and declare as follows:" ]]></expression>
			<property name="com.jaspersoft.studio.unit.y" value="pixel"/>
			<property name="com.jaspersoft.studio.unit.width" value="px"/>
		</element>
		<element kind="textField" uuid="9b846ff5-513b-4330-ac34-17de9d9fe865" positionType="Float" x="1" y="93" width="555" height="30" fontSize="11.0" textAdjust="StretchHeight" hTextAlign="Justified">
			<expression><![CDATA["1. That I am a bona fide citizen of Bangladesh and permanent resident of Bangladesh having Bangladesh nationality by birth."]]></expression>
			<property name="com.jaspersoft.studio.unit.y" value="pixel"/>
			<property name="com.jaspersoft.studio.unit.width" value="px"/>
		</element>
		<element kind="textField" uuid="7a725acb-4b33-4286-907e-533ac941cbb6" positionType="Float" x="1" y="126" width="555" height="30" fontSize="11.0" textAdjust="StretchHeight" hTextAlign="Justified">
			<expression><![CDATA["2. That in my National Identification Card, bearing No. " + $F{NID}+", "+ "my father’s name was mentioned as " + $F{OwnerFatherName} + " and my mother’s name was mentioned as " +  $F{OwnerMotherName} + ". "]]></expression>
			<property name="com.jaspersoft.studio.unit.y" value="pixel"/>
			<property name="com.jaspersoft.studio.unit.width" value="px"/>
		</element>
	</pageHeader>
