<jasperReport name="account_statement_ssp" language="java" pageWidth="695" pageHeight="983" whenNoDataType="AllSectionsNoDetail" columnWidth="655" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="10" uuid="6e7650f8-3148-48bc-a43c-1bbad7205884">
