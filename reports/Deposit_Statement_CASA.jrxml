	<dataset name="Transactions" uuid="daed6d50-0863-4cc7-a4df-590e1fe0acca">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="NG Database Connection"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="411"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="582"/>
		<parameter name="ACCOUNT_NO" class="java.lang.String"/>
		<parameter name="FROM_DATE" class="java.sql.Date"/>
		<parameter name="TO_DATE" class="java.sql.Date"/>
		<parameter name="IS_HL" class="java.lang.Integer"/>
		<parameter name="CURR_DATE" class="java.sql.Date"/>
		<parameter name="branch_id" class="java.lang.Integer"/>
		<query language="SQL"><![CDATA[SELECT * FROM (
select  ACC.ID ACCID,V.TRAMOUNT,V.TRDATE,V.TRINTRUMENTNO,NVL(V.TRNARRATION, ' ') TRNARRATION,V.TRTRDID,V.TXNCODE,V.ID,
case when substr(V.TRTRDID,1,1)=1 then V.TRAMOUNT else 0 end CREDIT,
case when substr(V.TRTRDID,1,1)=2 then V.TRAMOUNT else 0 end DEBIT,V.TRGLOBALTXNNO GLOBALTXNNO
FROM ACCOUNTS acc,vw_accountstatement v
WHERE ACC.ID =V.ACCID

  and ACC.CODE = $P{ACCOUNT_NO} 
  and v.trdate BETWEEN to_date($P{FROM_DATE})  AND  to_date($P{TO_DATE})  
  AND upper(v.trisvalid)='TRUE'  
union all
SELECT ID ACCID,0 TRAMOUNT,TO_DATE($P{FROM_DATE})-1 as TRDATE, null TRINTRUMENTNO, 'Balance B/F' 
  TRNARRATION,100000 TRTRDID,null TXNCODE,0 ID,nvl(GETACCPREVBALANCE ( ID, TO_DATE($P{FROM_DATE})-1, 1 ),0) CREDIT,0 DEBIT,0 GLOBALTXNNO
 FROM ACCOUNTS 
 WHERE
 CODE=$P{ACCOUNT_NO} 
 ) 
order by TRDATE,ID,TRTRDID]]></query>
		<field name="ACCID" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.label" value="ACCID"/>
		</field>
		<field name="TRAMOUNT" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.label" value="TRAMOUNT"/>
		</field>
		<field name="TRDATE" class="java.sql.Date">
			<property name="com.jaspersoft.studio.field.label" value="TRDATE"/>
		</field>
		<field name="TRINTRUMENTNO" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="TRINTRUMENTNO"/>
		</field>
		<field name="TRNARRATION" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="TRNARRATION"/>
		</field>
		<field name="TRTRDID" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.label" value="TRTRDID"/>
		</field>
		<field name="TXNCODE" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="TXNCODE"/>
		</field>
		<field name="ID" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.label" value="ID"/>
		</field>
		<field name="CREDIT" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.label" value="CREDIT"/>
		</field>
		<field name="DEBIT" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.label" value="DEBIT"/>
		</field>
		<field name="GLOBALTXNNO" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.label" value="GLOBALTXNNO"/>
		</field>
		<variable name="blance" calculation="Sum" class="java.lang.Double">
			<expression><![CDATA[$F{CREDIT} - $F{DEBIT}]]></expression>
		</variable>
		<variable name="CreditSum" calculation="Sum" class="java.lang.Double">
			<expression><![CDATA[$F{TRNARRATION}.equals( "Balance B/F" )?0.0:$F{CREDIT}]]></expression>
		</variable>
		<variable name="DebitSum" calculation="Sum" class="java.lang.Double">
			<expression><![CDATA[$F{DEBIT}]]></expression>
		</variable>
	</dataset>
	<parameter name="AC_NO" class="java.lang.String"/>
	<parameter name="DAY_1" class="java.sql.Date"/>
	<parameter name="DAY_2" class="java.sql.Date"/>
	<parameter name="IS_HL" evaluationTime="Early" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[(int) 0]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT CUCODE,
       CURRENCY_CODE,
       CURR_DATE,
       COUNTRY_ID,
       ACCID,
       ADDRESS_LINE,
       (CASE WHEN COUNTRY_ID = 19 THEN ACCADDRESS ELSE FACCADDRESS END)
          ACCADDRESS,
       FACCADDRESS,
       CADD,
       CUSADDRESS,
       ACCCODE,
       BRANCHID,
       BRNAME,
       BRADDRESS,
       ADDADDRESS1,
       PRODUCTTYPE,
       PRODUCT_NAME,
       OPENDATE,
       DESCRIPTION,
       LASTTXNDATE,
       PHONE,
       STATUS,
       balance
  FROM (SELECT ACC.NAME AS cucode,
               acc.CURRENCY_CODE,
               get_current_date curr_date,
               acc.country_id,
               acc.ID accid,
               acc.ADDRESS_LINE,
                  acc.ADDRESS_LINE
               || ','
               || acc.ADDRESS_LINE_TWO
               || ','
               || (SELECT INITCAP (UPAZILA_NAME)
                     FROM UPAZILLA
                    WHERE ID = acc.UPAZILLA_ID AND DISTRICT_ID = DISTRICT_ID)
               || ','
               || (SELECT code
                     FROM post_codes
                    WHERE ID = acc.POST_CODE_ID)
               || ', '
               || (SELECT INITCAP (DISTRICT_NAME)
                     FROM DISTRICT
                    WHERE ID = acc.DISTRICT_ID)
               || ','
               || (SELECT (DIVISION_NAME)
                     FROM DIVISION
                    WHERE ID = acc.DIVISION_ID)
                  accaddress,
                  acc.ADDRESS_LINE
               || ','
               || acc.ADDRESS_LINE_TWO
               || ','
               || acc.FOREIGN_ZIP_CODE
               || ','
               || acc.FOREIGN_POST_OFFICE
               || ','
               || acc.FOREIGN_CITY
               || ', '
               || acc.FOREIGN_STATE
               || ','
               || (SELECT INITCAP (COUNTRY_NAME)
                     FROM COUNTRY
                    WHERE ID = acc.COUNTRY_ID)
                  faccaddress,
               cc.ADDRESS_LINE cadd,
                  cc.ADDRESS_LINE
               || ','
               || cc.ADDRESS_LINE_TWO
               || ','
               || (SELECT INITCAP (UPAZILA_NAME)
                     FROM UPAZILLA
                    WHERE     ID = cc.UPAZILLA_ID
                          AND DISTRICT_ID = DISTRICT_ID)
               || ', '
               || (SELECT INITCAP (DISTRICT_NAME)
                     FROM DISTRICT
                    WHERE ID = cc.DISTRICT_ID)
                  cusaddress,
               acc.code acccode,
               acc.BRANCH_ID BRANCHID,
               br.bname BRNAME,
               br.baddress BRADDRESS,
               NULL AS ADDADDRESS1,
               DECODE (P.TYPE,
                       'DEMAND_DEPOSIT', 'DEMAND DEPOSIT',
                       'RECURRING_DEPOSIT', 'RECURRING DEPOSIT',
                       'FIXED_DEPOSIT', 'FIXED DEPOSIT',
                       'other')
                  AS PRODUCTTYPE,
               P.NAME PRODUCT_NAME,
               OPENING_DATE AS OPENDATE,
               p.DESCRIPTION,
               LAST_CLIENT_TRANSACTION_DATE AS LASTTXNDATE,
                  DECODE (acc.PHONE_NUMBER,
                          NULL, NULL,
                          acc.PHONE_NUMBER || ', ')
               || acc.MOBILE_NUMBER
                  Phone,
               acc.STATUS,
               CB.CURRENT_BALANCE balance
          FROM ACCOUNTS acc,
               CASA_BALANCES CB,
               PRODUCTS P,
               cis_customer cc,
               branch br
         WHERE     ACC.code = $P{AC_NO}
               AND ACC.PRODUCT_ID = P.ID
               AND ACC.ID = CB.ACCOUNT_ID(+)
               AND cc.CUSID = ACC.CUSTOMER_ID
               AND cc.CUSTOMER_TYPE = 'INDIVIDUAL_SINGLE'
               AND CC.CUSID NOT IN (SELECT CUS_ID FROM cis_subject)
               AND ACC.Branch_Id = br.bid(+)
        UNION
        SELECT ACC.NAME AS cucode,
               acc.CURRENCY_CODE,
               get_current_date curr_date,
               acc.country_id,
               acc.ID accid,
               acc.ADDRESS_LINE,
                  acc.ADDRESS_LINE
               || ','
               || acc.ADDRESS_LINE_TWO
               || ','
               || (SELECT INITCAP (UPAZILA_NAME)
                     FROM UPAZILLA
                    WHERE ID = acc.UPAZILLA_ID AND DISTRICT_ID = DISTRICT_ID)
               || ','
               || (SELECT code
                     FROM post_codes
                    WHERE ID = acc.POST_CODE_ID)
               || ', '
               || (SELECT INITCAP (DISTRICT_NAME)
                     FROM DISTRICT
                    WHERE ID = acc.DISTRICT_ID)
               || ','
               || (SELECT (DIVISION_NAME)
                     FROM DIVISION
                    WHERE ID = acc.DIVISION_ID)
                  accaddress,
                  acc.ADDRESS_LINE
               || ','
               || acc.ADDRESS_LINE_TWO
               || ','
               || acc.FOREIGN_ZIP_CODE
               || ','
               || acc.FOREIGN_POST_OFFICE
               || ','
               || acc.FOREIGN_CITY
               || ', '
               || acc.FOREIGN_STATE
               || ','
               || (SELECT INITCAP (COUNTRY_NAME)
                     FROM COUNTRY
                    WHERE ID = acc.COUNTRY_ID)
                  faccaddress,
               CIS_CUSTOMER.ADDRESS_LINE cadd,
                  CIS_CUSTOMER.ADDRESS_LINE
               || ','
               || CIS_CUSTOMER.ADDRESS_LINE_TWO
               || ','
               || (SELECT INITCAP (UPAZILA_NAME)
                     FROM UPAZILLA
                    WHERE     ID = CIS_CUSTOMER.UPAZILLA_ID
                          AND DISTRICT_ID = DISTRICT_ID)
               || ', '
               || (SELECT INITCAP (DISTRICT_NAME)
                     FROM DISTRICT
                    WHERE ID = CIS_CUSTOMER.DISTRICT_ID)
                  cusaddress,
               acc.code acccode,
               acc.BRANCH_ID BRANCHID,
               br.bname BRNAME,
               br.baddress BRADDRESS,
               (CASE
                   WHEN MAILING_ADDRESS = 'PRESENT_ADDRESS'
                   THEN
                         PRE_ADDRESS_LINE
                      || ','
                      || PRE_ADDRESS_LINE_TWO
                      || ','
                      || (SELECT INITCAP (UPAZILA_NAME)
                            FROM UPAZILLA
                           WHERE     ID = PRE_ADDRESS_UPAZILLA_ID
                                 AND DISTRICT_ID = PRE_ADDRESS_DISTRICT_ID)
                      || ', '
                      || (SELECT INITCAP (DISTRICT_NAME)
                            FROM DISTRICT
                           WHERE ID = PRE_ADDRESS_DISTRICT_ID)
                   WHEN MAILING_ADDRESS = 'PERMANENT_ADDRESS'
                   THEN
                         PERM_ADDRESS_LINE
                      || ','
                      || PERM_ADDRESS_LINE_TWO
                      || ','
                      || (SELECT INITCAP (UPAZILA_NAME)
                            FROM UPAZILLA
                           WHERE     ID = PERM_ADDRESS_UPAZILLA_ID
                                 AND DISTRICT_ID = PERM_ADDRESS_DISTRICT_ID)
                      || ', '
                      || (SELECT INITCAP (DISTRICT_NAME)
                            FROM DISTRICT
                           WHERE ID = PERM_ADDRESS_DISTRICT_ID)
                   ELSE
                         PROF_ADDRESS_LINE
                      || ','
                      || PROF_ADDRESS_LINE_TWO
                      || ','
                      || (SELECT INITCAP (UPAZILA_NAME)
                            FROM UPAZILLA
                           WHERE     ID = PROF_ADDRESS_UPAZILLA_ID
                                 AND DISTRICT_ID = PROF_ADDRESS_DISTRICT_ID)
                      || ', '
                      || (SELECT INITCAP (DISTRICT_NAME)
                            FROM DISTRICT
                           WHERE ID = PROF_ADDRESS_DISTRICT_ID)
                END)
                  AS ADDADDRESS1,
               DECODE (P.TYPE,
                       'DEMAND_DEPOSIT', 'DEMAND DEPOSIT',
                       'RECURRING_DEPOSIT', 'RECURRING DEPOSIT',
                       'FIXED_DEPOSIT', 'FIXED DEPOSIT',
                       'other')
                  AS PRODUCTTYPE,
               P.NAME PRODUCT_NAME,
               OPENING_DATE AS OPENDATE,
               p.DESCRIPTION,
               LAST_CLIENT_TRANSACTION_DATE AS LASTTXNDATE,
                  DECODE (acc.PHONE_NUMBER,
                          NULL, NULL,
                          acc.PHONE_NUMBER || ', ')
               || acc.MOBILE_NUMBER
                  Phone,
               acc.STATUS,
               CB.CURRENT_BALANCE balance
          FROM ACCOUNTS acc,
               CASA_BALANCES CB,
               PRODUCTS P,
               CIS_INDIVIDUAL_INFORMATION,
               CIS_SUBJECT,
               cis_customer,
               branch br
         WHERE     ACC.code = $P{AC_NO}
               AND ACC.PRODUCT_ID = P.ID
               AND ACC.ID = CB.ACCOUNT_ID(+)
               AND ACC.CUSTOMER_ID = CIS_SUBJECT.CUS_ID
               AND CIS_SUBJECT.SUBJECT_ID = CIS_INDIVIDUAL_INFORMATION.ID
               AND CIS_CUSTOMER.CUSID = ACC.CUSTOMER_ID
               AND cis_customer.CUSTOMER_TYPE = 'INDIVIDUAL_SINGLE'
               AND CIS_SUBJECT.SUBJECT_ID =
                      (SELECT MIN (C.SUBJECT_ID)
                         FROM CIS_SUBJECT c
                        WHERE cis_customer.CUSID = c.CUS_ID)
               AND ACC.Branch_Id = br.bid(+)
        UNION
        SELECT ACC.NAME AS cucode,
               acc.CURRENCY_CODE,
               get_current_date curr_date,
               acc.country_id,
               acc.ID accid,
               acc.ADDRESS_LINE,
                  acc.ADDRESS_LINE
               || ','
               || acc.ADDRESS_LINE_TWO
               || ','
               || (SELECT INITCAP (UPAZILA_NAME)
                     FROM UPAZILLA
                    WHERE ID = acc.UPAZILLA_ID AND DISTRICT_ID = DISTRICT_ID)
               || ','
               || (SELECT code
                     FROM post_codes
                    WHERE ID = acc.POST_CODE_ID)
               || ', '
               || (SELECT INITCAP (DISTRICT_NAME)
                     FROM DISTRICT
                    WHERE ID = acc.DISTRICT_ID)
               || ','
               || (SELECT (DIVISION_NAME)
                     FROM DIVISION
                    WHERE ID = acc.DIVISION_ID)
                  accaddress,
                  acc.ADDRESS_LINE
               || ','
               || acc.ADDRESS_LINE_TWO
               || ','
               || acc.FOREIGN_ZIP_CODE
               || ','
               || acc.FOREIGN_POST_OFFICE
               || ','
               || acc.FOREIGN_CITY
               || ', '
               || acc.FOREIGN_STATE
               || ','
               || (SELECT INITCAP (COUNTRY_NAME)
                     FROM COUNTRY
                    WHERE ID = acc.COUNTRY_ID)
                  faccaddress,
               CIS_CUSTOMER.ADDRESS_LINE cadd,
                  CIS_CUSTOMER.ADDRESS_LINE
               || ','
               || CIS_CUSTOMER.ADDRESS_LINE_TWO
               || ','
               || (SELECT INITCAP (UPAZILA_NAME)
                     FROM UPAZILLA
                    WHERE     ID = CIS_CUSTOMER.UPAZILLA_ID
                          AND DISTRICT_ID = DISTRICT_ID)
               || ', '
               || (SELECT INITCAP (DISTRICT_NAME)
                     FROM DISTRICT
                    WHERE ID = CIS_CUSTOMER.DISTRICT_ID)
                  cusaddress,
               acc.code acccode,
               acc.BRANCH_ID BRANCHID,
               br.bname BRNAME,
               br.baddress BRADDRESS,
               (CASE
                   WHEN MAILING_ADDRESS = 'PRESENT_ADDRESS'
                   THEN
                         PRE_ADDRESS_LINE
                      || ','
                      || PRE_ADDRESS_LINE_TWO
                      || ','
                      || (SELECT INITCAP (UPAZILA_NAME)
                            FROM UPAZILLA
                           WHERE     ID = PRE_ADDRESS_UPAZILLA_ID
                                 AND DISTRICT_ID = PRE_ADDRESS_DISTRICT_ID)
                      || ', '
                      || (SELECT INITCAP (DISTRICT_NAME)
                            FROM DISTRICT
                           WHERE ID = PRE_ADDRESS_DISTRICT_ID)
                   WHEN MAILING_ADDRESS = 'PERMANENT_ADDRESS'
                   THEN
                         PERM_ADDRESS_LINE
                      || ','
                      || PERM_ADDRESS_LINE_TWO
                      || ','
                      || (SELECT INITCAP (UPAZILA_NAME)
                            FROM UPAZILLA
                           WHERE     ID = PERM_ADDRESS_UPAZILLA_ID
                                 AND DISTRICT_ID = PERM_ADDRESS_DISTRICT_ID)
                      || ', '
                      || (SELECT INITCAP (DISTRICT_NAME)
                            FROM DISTRICT
                           WHERE ID = PERM_ADDRESS_DISTRICT_ID)
                   ELSE
                         PROF_ADDRESS_LINE
                      || ','
                      || PROF_ADDRESS_LINE_TWO
                      || ','
                      || (SELECT INITCAP (UPAZILA_NAME)
                            FROM UPAZILLA
                           WHERE     ID = PROF_ADDRESS_UPAZILLA_ID
                                 AND DISTRICT_ID = PROF_ADDRESS_DISTRICT_ID)
                      || ', '
                      || (SELECT INITCAP (DISTRICT_NAME)
                            FROM DISTRICT
                           WHERE ID = PROF_ADDRESS_DISTRICT_ID)
                END)
                  AS ADDADDRESS1,
               DECODE (P.TYPE,
                       'DEMAND_DEPOSIT', 'DEMAND DEPOSIT',
                       'RECURRING_DEPOSIT', 'RECURRING DEPOSIT',
                       'FIXED_DEPOSIT', 'FIXED DEPOSIT',
                       'other')
                  AS PRODUCTTYPE,
               P.NAME PRODUCT_NAME,
               OPENING_DATE AS OPENDATE,
               p.DESCRIPTION,
               LAST_CLIENT_TRANSACTION_DATE AS LASTTXNDATE,
                  DECODE (acc.PHONE_NUMBER,
                          NULL, NULL,
                          acc.PHONE_NUMBER || ', ')
               || acc.MOBILE_NUMBER
                  Phone,
               acc.STATUS,
               CB.CURRENT_BALANCE balance
          FROM ACCOUNTS acc,
               CASA_BALANCES CB,
               PRODUCTS P,
               CIS_INDIVIDUAL_INFORMATION,
               CIS_SUBJECT,
               cis_customer,
               branch br
         WHERE     ACC.code = $P{AC_NO}
               AND ACC.PRODUCT_ID = P.ID
               AND ACC.ID = CB.ACCOUNT_ID(+)
               AND ACC.CUSTOMER_ID = CIS_SUBJECT.CUS_ID(+)
               AND CIS_SUBJECT.SUBJECT_ID = CIS_INDIVIDUAL_INFORMATION.ID(+)
               AND CIS_CUSTOMER.CUSID = ACC.CUSTOMER_ID
               AND cis_customer.CUSTOMER_TYPE = 'INDIVIDUAL_JOINT'
               AND ROWNUM = 1
               AND ACC.Branch_Id = br.bid(+)
        UNION
        SELECT ACC.NAME AS cucode,
               acc.CURRENCY_CODE,
               get_current_date curr_date,
               acc.country_id,
               acc.ID accid,
               acc.ADDRESS_LINE,
                  acc.ADDRESS_LINE
               || ','
               || acc.ADDRESS_LINE_TWO
               || ','
               || (SELECT INITCAP (UPAZILA_NAME)
                     FROM UPAZILLA
                    WHERE ID = acc.UPAZILLA_ID AND DISTRICT_ID = DISTRICT_ID)
               || ','
               || (SELECT code
                     FROM post_codes
                    WHERE ID = acc.POST_CODE_ID)
               || ', '
               || (SELECT INITCAP (DISTRICT_NAME)
                     FROM DISTRICT
                    WHERE ID = acc.DISTRICT_ID)
               || ','
               || (SELECT (DIVISION_NAME)
                     FROM DIVISION
                    WHERE ID = acc.DIVISION_ID)
                  accaddress,
                  acc.ADDRESS_LINE
               || ','
               || acc.ADDRESS_LINE_TWO
               || ','
               || acc.FOREIGN_ZIP_CODE
               || ','
               || acc.FOREIGN_POST_OFFICE
               || ','
               || acc.FOREIGN_CITY
               || ', '
               || acc.FOREIGN_STATE
               || ','
               || (SELECT INITCAP (COUNTRY_NAME)
                     FROM COUNTRY
                    WHERE ID = acc.COUNTRY_ID)
                  faccaddress,
               CIS_CUSTOMER.ADDRESS_LINE cadd,
                  CIS_CUSTOMER.ADDRESS_LINE
               || ','
               || CIS_CUSTOMER.ADDRESS_LINE_TWO
               || ','
               || (SELECT INITCAP (UPAZILA_NAME)
                     FROM UPAZILLA
                    WHERE     ID = CIS_CUSTOMER.UPAZILLA_ID
                          AND DISTRICT_ID = DISTRICT_ID)
               || ', '
               || (SELECT INITCAP (DISTRICT_NAME)
                     FROM DISTRICT
                    WHERE ID = CIS_CUSTOMER.DISTRICT_ID)
                  cusaddress,
               acc.code acccode,
               acc.BRANCH_ID BRANCHID,
               br.bname BRNAME,
               br.baddress BRADDRESS,
               (CASE
                   WHEN MAILING_ADDRESS = 'BUSINESS_ADDRESS'
                   THEN
                         BUSI_ADDRESS_LINE
                      || ','
                      || acc.ADDRESS_LINE_TWO
                      || ','
                      || (SELECT INITCAP (UPAZILA_NAME)
                            FROM UPAZILLA
                           WHERE     ID = BUSI_ADDRESS_UPAZILLA_ID
                                 AND DISTRICT_ID = BUSI_ADDRESS_DISTRICT_ID)
                      || ', '
                      || (SELECT INITCAP (DISTRICT_NAME)
                            FROM DISTRICT
                           WHERE ID = BUSI_ADDRESS_DISTRICT_ID)
                   WHEN MAILING_ADDRESS = 'FACTORY_ADDRESS'
                   THEN
                         FACT_ADDRESS_LINE
                      || ','
                      || acc.ADDRESS_LINE_TWO
                      || ','
                      || (SELECT INITCAP (UPAZILA_NAME)
                            FROM UPAZILLA
                           WHERE     ID = FACT_ADDRESS_UPAZILLA_ID
                                 AND DISTRICT_ID = FACT_ADDRESS_DISTRICT_ID)
                      || ', '
                      || (SELECT INITCAP (DISTRICT_NAME)
                            FROM DISTRICT
                           WHERE ID = FACT_ADDRESS_DISTRICT_ID)
                   ELSE
                         REG_ADDRESS_LINE
                      || ','
                      || acc.ADDRESS_LINE_TWO
                      || ','
                      || (SELECT INITCAP (UPAZILA_NAME)
                            FROM UPAZILLA
                           WHERE     ID = REG_ADDRESS_UPAZILLA_ID
                                 AND DISTRICT_ID = REG_ADDRESS_DISTRICT_ID)
                      || ', '
                      || (SELECT INITCAP (DISTRICT_NAME)
                            FROM DISTRICT
                           WHERE ID = REG_ADDRESS_DISTRICT_ID)
                END)
                  AS ADDADDRESS1,
               DECODE (P.TYPE,
                       'DEMAND_DEPOSIT', 'DEMAND DEPOSIT',
                       'RECURRING_DEPOSIT', 'RECURRING DEPOSIT',
                       'FIXED_DEPOSIT', 'FIXED DEPOSIT',
                       'other')
                  AS PRODUCTTYPE,
               P.NAME PRODUCT_NAME,
               OPENING_DATE AS OPENDATE,
               p.DESCRIPTION,
               LAST_CLIENT_TRANSACTION_DATE AS LASTTXNDATE,
                  DECODE (acc.PHONE_NUMBER,
                          NULL, NULL,
                          acc.PHONE_NUMBER || ', ')
               || acc.MOBILE_NUMBER
                  Phone,
               acc.STATUS,
               CB.CURRENT_BALANCE balance
          FROM ACCOUNTS acc,
               CASA_BALANCES CB,
               PRODUCTS P,
               CIS_ORGANIZATIONS,
               CIS_SUBJECT,
               CIS_CUSTOMER,
               branch br
         WHERE     ACC.code = $P{AC_NO}
               AND ACC.PRODUCT_ID = P.ID
               AND ACC.ID = CB.ACCOUNT_ID(+)
               AND ACC.CUSTOMER_ID = CIS_SUBJECT.CUS_ID(+)
               AND CIS_SUBJECT.SUBJECT_ID = CIS_ORGANIZATIONS.ID(+)
               AND CIS_CUSTOMER.CUSTOMER_TYPE = 'ORGANIZATION'
               AND CIS_CUSTOMER.CUSID = ACC.CUSTOMER_ID
               AND ACC.Branch_Id = br.bid(+))
WHERE UPPER(PRODUCTTYPE) = 'DEMAND DEPOSIT']]></query>
